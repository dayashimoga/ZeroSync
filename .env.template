# ==============================================================================
# AirDrop-QR / ZeroSync Environment Configuration Template
# STRICT ZERO-TRUST AIR-GAP COMPLIANCE SPECIFICATION
# ==============================================================================
# INVARIANT: Under no circumstances may remote telemetry, analytics, or
# cloud synchronizers be configured. All keys below are strictly local.

# Application Identity & Build Configuration
APP_NAME="AirDrop-QR / ZeroSync"
APP_ENV=development # [development, staging, production]
APP_VERSION=1.0.0
BUILD_NUMBER=1

# Local Cryptographic Key Management (AES-256-GCM / SQLCipher)
# Generated via hardware keystore / keychain locally on device.
# For local deterministic tests only:
ZEROSYNC_LOCAL_VAULT_DB_NAME="zerosync_vault.enc.db"
ZEROSYNC_PBKDF2_ITERATIONS=256000

# Optical Transmission Protocol (ZSP-V1) Defaults
ZSP_DEFAULT_MTU_BYTES=180          # Frame payload slice size
ZSP_DEFAULT_FPS=15                 # Transmission rate (5 to 30 FPS)
ZSP_DEFAULT_ECC_LEVEL="M"          # [L, M, Q, H]
ZSP_MAX_PAYLOAD_BYTES=52428800     # 50 MB hard cap for air-gap transfers
ZSP_INACTIVITY_SLEEP_SECONDS=180   # 3 minutes idle timeout for camera sensor

# Device Hardware Simulation & Testing
SIMULATED_PACKET_DROP_RATE=0.0     # 0.0 to 0.40 for optical fault-tolerance tests
ENABLE_HIGH_CONTRAST_DEFAULT=true
ENABLE_HAPTIC_FEEDBACK=true
